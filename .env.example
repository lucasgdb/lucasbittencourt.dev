# Optional. video-downloader-api, where the uninstall survey
# (/tool/video-downloader/uninstall) sends its answers. Unset: the local API
# (http://localhost:8082) under `next dev`, the real one in a build. That API
# must list this site's origin in its CORS_ALLOWED_ORIGINS
# (http://localhost:3000 locally, https://lucasbittencourt.dev in production).
# NEXT_PUBLIC_VIDEO_DOWNLOADER_API_URL=http://localhost:8082

# Optional. ai-summarizer-api, where the uninstall survey
# (/tool/ai-summarizer/uninstall) sends its answers. Unset: the local API
# (http://localhost:8080) under `next dev`, the real one in a build. That API
# must list this site's origin in its CORS_ALLOWED_ORIGINS too.
# NEXT_PUBLIC_AI_SUMMARIZER_API_URL=http://localhost:8080
